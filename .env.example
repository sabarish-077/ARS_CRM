DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_HSTS_SECONDS=3600
DB_NAME=ars_garments_crm
DB_USER=ars_crm_user
DB_PASSWORD=replace-with-your-local-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60
# Aiven: set this to the downloaded CA .pem path, or paste its PEM contents as a secret environment variable.
DB_SSL_CA=
# For Vercel, use the base64-encoded contents of the Aiven CA certificate instead.
DB_SSL_CA_BASE64=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-user
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=ARS Garments Staff CRM <no-reply@example.com>
